APP_NAME=php-vuln-site
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
DB_CONNECTION=sqlite

# nr-authz-radar: observe = IDOR happens but is recorded (demonstrates D01). Set to enforce to block it.
AUTHZ_RADAR_ENABLED=true
AUTHZ_RADAR_HMAC_KEY=local-demo-key-change-me
AUTHZ_RADAR_ATTRIBUTES=minimal
AUTHZ_RADAR_OWNERSHIP_MODE=observe
AUTHZ_RADAR_LOG_DECISIONS=true

# Point these at your own New Relic account to see the data (optional; the demo works without it).
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APPNAME=php-vuln-site
AUTHZ_RADAR_LOG_CHANNEL=single
