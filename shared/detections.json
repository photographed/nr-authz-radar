{
  "levels": {
    "evidence": {
      "ja": "証拠",
      "en": "evidence",
      "meaning_ja": "1件でも、攻撃（またはその成功）をアプリ自身の判定や実行された事実として示す",
      "meaning_en": "a single event shows an attack (or its success) as the application's own decision or an executed fact"
    },
    "strong": {
      "ja": "強い兆候",
      "en": "strong signal",
      "meaning_ja": "正常な利用ではほぼ起きない試みの痕跡。成功は示さない",
      "meaning_en": "a trace of an attempt that normal use rarely produces; does not show success"
    },
    "anomaly": {
      "ja": "異常",
      "en": "anomaly",
      "meaning_ja": "量・割合・形の平常時からの変化。攻撃とは呼ばない",
      "meaning_en": "a change in volume, ratio or shape from normal; never called an attack"
    },
    "risk": {
      "ja": "リスク",
      "en": "risk",
      "meaning_ja": "攻撃の兆候ではなく、設定上のリスク",
      "meaning_en": "a configuration risk, not an attack signal"
    },
    "context": {
      "ja": "参考",
      "en": "context",
      "meaning_ja": "相関のための参照",
      "meaning_en": "reference data for correlation"
    }
  },
  "correlations": [
    {
