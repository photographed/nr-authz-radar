resource "newrelic_nrql_alert_condition" "d04" {
  account_id                   = var.account_id
  policy_id                    = newrelic_alert_policy.authz_radar.id
  type                         = "baseline"
  name                         = "[authz-radar] D04 403 / 404 比率の急上昇"
  description                  = "nr-authz-radar D04 / stage S0"
  runbook_url                  = "${var.runbook_base_url}/recon.md"
  enabled                      = true
  violation_time_limit_seconds = 86400
  aggregation_window           = 300
  aggregation_method           = "event_flow"
  aggregation_delay            = 120
  baseline_direction           = "upper_only"

  nrql {
    query = "SELECT percentage(count(*), WHERE http.statusCode IN (403, 404)) FROM Transaction WHERE appName = '${var.app_name}' AND transactionType = 'Web'"
  }

  critical {
    operator              = "above"
    threshold             = 4
    threshold_duration    = 300
    threshold_occurrences = "at_least_once"
  }
  warning {
    operator              = "above"
    threshold             = 3
